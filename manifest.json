{
  "manifest_version": 3,
  "name": "Web Test Bench",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://github.com/petrzpav/web-test-bench",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" } }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["content/probe.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content/bridge.js"]
    }
  ]
}
